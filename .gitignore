# Ignore Rust build artifacts
/target/
rust/AssemblerWeb/target/
rust/AssemblerTest/target/
rust/Assembler/target/

# Ignore C# build artifacts
**/bin/
**/obj/

# Ignore VS Code settings
.vscode/

# Ignore user-specific files
*.swp
*.swo
*.tmp
*.log

# Ignore Log directories
Log/
*/Log/
**/Log/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore other common files
*.user
*.rs.bk
*.bak
*.exe
*.dll
*.out
*.so
*.a
*.lib
*.pdb
*.class
*.jar
*.o
*.obj
*.pyc
*.zip
*.tar
*.gz
*.7z
*.db
*.sqlite
*.msi
*.apk
*.app
*.dmg
*.iso
*.bin
*.tmp
*.tgz

# Ignore Python cache
__pycache__/
*.pyc

# Ignore node_modules if present
node_modules/

# Ignore all template analysis files
**/template_analysis/
**/tmp/

# Ignore all Fly deploy batch scripts
fly_deploy*.bat
rust/fly_deploy_rust_web.bat
go/fly_deploy_go_web.bat
node/fly_deploy_node_web.bat
csharp/fly_deploy_csharp_web.bat
csharp/fly_deploy_js_web.bat
csharp/fly_run_csharp_web.bat
csharp/fly_run_js_web.bat

# Ignore local Claude settings
.claude/settings.local.json
/test/
/deploy/

# Ignore temporary local package directories (but keep LocalPackages/)
**/LocalNuGetPackages/
**/PolyglotLocalNuGetPackages/

# Exception: allow package files in LocalPackages directory
!LocalPackages/*.tgz
!LocalPackages/*.zip